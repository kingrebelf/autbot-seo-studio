{
  "name": "autbot-seo-studio",
  "productName": "Autbot SEO Studio",
  "version": "1.0.0",
  "description": "A free, open-source desktop app that lets a small-business owner run their own SEO content system.",
  "license": "MIT",
  "author": "Autbot",
  "homepage": "https://github.com/kingrebelf/autbot-seo-studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingrebelf/autbot-seo-studio.git"
  },
  "main": "./out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:mock": "cross-env AUTBOT_DEV=1 electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build && electron-builder",
    "build:app": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "node scripts/run-electron-node.cjs node_modules/vitest/vitest.mjs run",
    "test:smoke": "electron-vite build && playwright test",
    "db:generate": "drizzle-kit generate",
    "postinstall": "electron-builder install-app-deps",
    "icons": "node scripts/make-icons.cjs"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "better-sqlite3": "~12.11.1",
    "cheerio": "^1.1.2",
    "drizzle-orm": "^0.45.4",
    "extract-zip": "^2.0.1",
    "marked": "^16.4.1",
    "node-cron": "^4.2.1",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.5",
    "turndown": "^7.2.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tiptap/extension-image": "^3.10.0",
    "@tiptap/extension-link": "^3.10.0",
    "@tiptap/extension-placeholder": "^3.10.0",
    "@tiptap/extension-table": "^3.10.0",
    "@tiptap/pm": "^3.10.0",
    "@tiptap/react": "^3.10.0",
    "@tiptap/starter-kit": "^3.10.0",
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/sanitize-html": "^2.16.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "diff": "^8.0.2",
    "drizzle-kit": "^0.31.6",
    "electron": "~42.11.14",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "lucide-react": "^0.548.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^3.3.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
